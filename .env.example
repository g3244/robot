# انسخ هذا الملف إلى .env واملأ القيم من لوحة تحكم Twilio
# https://console.twilio.com

# Account SID (تلاقيه في الصفحة الرئيسية للوحة تحكم Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token (سري جدًا - لا تشاركه ولا تضعه في كود الواجهة الأمامية أبدًا)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# الرقم المرسل: إما رقم اشتريته من Twilio بصيغة +1XXXXXXXXXX
# أو (أفضل وأرخص للتحقق) استخدم Verify Service SID بدلاً من ذلك - راجع server.js
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# المنفذ اللي هيشتغل عليه السيرفر محليًا
PORT=3000

# الدومين المسموح له يكلم السيرفر (دومين صفحة الـ HTML بتاعتك بعد ما ترفعها)
# استخدم * وقت التجربة المحلية فقط، وحدده لاحقًا لأمان أفضل
ALLOWED_ORIGIN=*
